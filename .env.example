# PostgreSQL
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rumbo_production
DATABASE_URL=postgresql://rumbo:replace-with-a-long-random-password@localhost:5432/rumbo_production
PGSSLMODE=disable

# Rumbo API — fuente única para catálogo, reservas, sesiones, pagos e integraciones.
RUMBO_API_URL=http://localhost:4000
RUMBO_API_KEY=replace-with-a-long-random-api-key
RUMBO_INTEGRATION_MASTER_KEY=replace-with-a-different-long-random-master-key
RUMBO_PAYMENT_CHECKOUT_SECRET=replace-with-a-long-random-hmac-secret
RUMBO_PUBLIC_URL=http://localhost:3001
RUMBO_DEMO_MODE=false
RUMBO_ADMIN_EMAIL=admin@example.com
RUMBO_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Cloudflare R2 — preferido: guardar credenciales desde Administración → APIs.
CLOUDFLARE_ACCOUNT_ID=b0c9535ffd40623838c8b025cc4bcda9
CLOUDFLARE_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=rumbo-images
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-4a41d3634afa4e46b3be096a1d931aa7.r2.dev

# Izipay / MiCuentaWeb — preferido: guardar desde Administración → APIs.
IZIPAY_API_URL=https://api.micuentaweb.pe
IZIPAY_STATIC_BASE_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0
IZIPAY_USERNAME=replace-with-izipay-rest-username
IZIPAY_PASSWORD=replace-with-izipay-rest-password
IZIPAY_PUBLIC_KEY=replace-with-izipay-public-key
IZIPAY_HMAC_SHA256_KEY=replace-with-izipay-hmac-sha256-key

# AirLabs — sin respaldo local.
AIRLABS_API_BASE_URL=https://airlabs.co/api/v9
AIRLABS_API_KEY=replace-with-airlabs-api-key

# PriceTravel B2B — preferido: guardar desde Administración → APIs.
PRICETRAVEL_API_URL=https://replace-with-current-pricetravel-host
PRICETRAVEL_PACKAGES_PATH=/replace-with-current-packages-route
PRICETRAVEL_USERNAME=replace-with-pricetravel-user
PRICETRAVEL_PASSWORD=replace-with-pricetravel-password
