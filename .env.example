# PostgreSQL
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rumbo_production

# Spree Commerce
SPREE_SECRET_KEY_BASE=replace-with-a-long-random-secret
SPREE_RAILS_HOST=localhost:3000
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# Storefront integration
SPREE_API_URL=http://localhost:3000
SPREE_PUBLISHABLE_API_KEY=replace-after-creating-the-key-in-spree-admin

# Amadeus Self-Service — Airport & City Search
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
AMADEUS_API_KEY=replace-with-amadeus-api-key
AMADEUS_API_SECRET=replace-with-amadeus-api-secret

# PriceTravel B2B — valores entregados durante el onboarding comercial
PRICETRAVEL_API_URL=https://replace-with-current-pricetravel-sandbox-host
PRICETRAVEL_PACKAGES_PATH=/replace-with-current-packages-route
PRICETRAVEL_USERNAME=replace-with-pricetravel-user
PRICETRAVEL_PASSWORD=replace-with-pricetravel-password
