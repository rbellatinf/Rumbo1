# PostgreSQL
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rumbo_production

# Spree Commerce
SPREE_SECRET_KEY_BASE=replace-with-a-long-random-secret
SPREE_RAILS_HOST=localhost:3000
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# Storefront integration
SPREE_API_URL=http://localhost:3000
SPREE_PUBLISHABLE_API_KEY=replace-after-creating-the-key-in-spree-admin
RUMBO_STOREFRONT_URL=http://localhost:3001

# Rumbo payment handoff — configure the same checkout secret in Spree and storefront.
RUMBO_PAYMENT_PROVIDER=izipay
RUMBO_PAYMENT_CHECKOUT_URL=http://localhost:3001/pagar
RUMBO_PAYMENT_CHECKOUT_SECRET=replace-with-a-long-random-hmac-secret
RUMBO_PAYMENT_WEBHOOK_URL=http://localhost:3000/api/v3/store/payment_webhooks/izipay
RUMBO_PAYMENT_WEBHOOK_SECRET_IZIPAY=replace-with-a-different-long-random-hmac-secret
RUMBO_PAYMENT_RETURN_URL=http://localhost:3001/reservas

# Izipay / MiCuentaWeb REST + Krypton V4
# Keep USERNAME, PASSWORD and HMAC only on the server. PUBLIC_KEY is safe for the form.
IZIPAY_API_URL=https://api.micuentaweb.pe
IZIPAY_STATIC_BASE_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0
IZIPAY_USERNAME=replace-with-izipay-rest-username
IZIPAY_PASSWORD=replace-with-izipay-rest-password
IZIPAY_PUBLIC_KEY=replace-with-izipay-public-key
IZIPAY_HMAC_SHA256_KEY=replace-with-izipay-hmac-sha256-key
IZIPAY_DEFAULT_CUSTOMER_EMAIL=pagos@example.com
IZIPAY_ALLOWED_CURRENCIES=PEN,USD

# AirLabs — Airport Autocomplete / Name Suggestion
AIRLABS_API_BASE_URL=https://airlabs.co/api/v9
AIRLABS_API_KEY=replace-with-airlabs-api-key

# PriceTravel B2B — valores entregados durante el onboarding comercial
PRICETRAVEL_API_URL=https://replace-with-current-pricetravel-sandbox-host
PRICETRAVEL_PACKAGES_PATH=/replace-with-current-packages-route
PRICETRAVEL_USERNAME=replace-with-pricetravel-user
PRICETRAVEL_PASSWORD=replace-with-pricetravel-password
